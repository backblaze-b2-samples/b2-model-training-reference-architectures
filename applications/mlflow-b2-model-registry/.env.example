# Copy to .env, chmod 600 .env. Never commit .env.
# Use a bucket-scoped application key, not the master key.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
# Region of the bucket, e.g. the "s3.<region>.backblazeb2.com" part of its endpoint.
B2_REGION=
# Optional override; derived from B2_REGION when empty. Must keep the s3.<region>.backblazeb2.com form.
B2_ENDPOINT=
# Local sqlite by default; use the tracking server from infrastructure/mlflow for a team.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Artifacts go to b2://<bucket>@s3.<region>.backblazeb2.com/<prefix>/<experiment>.
B2_MLFLOW_PREFIX=mlflow
# Signing secret from the bucket's event notification rule; needed by handle-event and serve-events.
B2_EVENT_SIGNING_SECRET=
