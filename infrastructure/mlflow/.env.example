# Copy to .env, chmod 600 .env. Never commit .env. Placeholders only.
# "proxy": server streams artifacts to B2, clients hold no B2 key. "direct": clients write to B2 themselves.
COMPOSE_PROFILES=proxy
# URL-safe characters only; it is embedded in the PostgreSQL connection URI.
POSTGRES_PASSWORD=<generate-a-long-random-value>
# Server key, scoped to the bucket (and ideally a name prefix). Capabilities per mode are in README.md.
B2_APPLICATION_KEY_ID=<server-key-id>
B2_APPLICATION_KEY=<server-application-key>
B2_BUCKET_NAME=<bucket>
# The "s3.<region>.backblazeb2.com" part of the bucket endpoint.
B2_REGION=<region>
B2_MLFLOW_PREFIX=mlflow
MLFLOW_PORT=5000
# Host headers the server accepts; add your DNS name when exposing it beyond localhost.
MLFLOW_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,mlflow:*
