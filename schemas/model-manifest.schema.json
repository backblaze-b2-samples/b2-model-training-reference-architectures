{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:backblaze:b2-model-training-reference-architectures:model-manifest:1",
  "title": "Promoted model manifest",
  "description": "Written last under models/<model>/<version>/. Records lineage from dataset version to checkpoint to promoted model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "model",
    "version",
    "format",
    "framework",
    "source",
    "dataset",
    "metrics",
    "files",
    "fingerprint",
    "retention_mode"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+@[a-z0-9._-]+$"
    },
    "model": {
      "$ref": "#/$defs/name"
    },
    "version": {
      "$ref": "#/$defs/name"
    },
    "format": {
      "enum": [
        "torch.distributed.checkpoint",
        "torch.save",
        "safetensors",
        "mlflow"
      ]
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "step",
        "checkpoint_fingerprint"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+$"
        },
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "checkpoint_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "dataset": {
      "$ref": "#/$defs/datasetPin"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "files": {
      "$ref": "#/$defs/files"
    },
    "fingerprint": {
      "description": "SHA-256 over the sorted lines '<path>:<sha256>' of every entry in files, joined with newlines",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "retention_mode": {
      "enum": [
        "governance",
        "compliance",
        "none"
      ]
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "datasetPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fingerprint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+@[a-z0-9._-]+$"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*//)[A-Za-z0-9._/-]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  }
}
