{
  "bucketId": "<datasets-bucket-id>",
  "eventNotificationRules": [
    {
      "name": "retrain-on-new-dataset",
      "eventTypes": ["b2:ObjectCreated:Upload", "b2:ObjectCreated:MultipartUpload"],
      "objectNamePrefix": "datasets/",
      "isEnabled": true,
      "maxEventsPerBatch": 1,
      "targetConfiguration": {
        "targetType": "webhook",
        "url": "https://hooks.example.com/b2/datasets",
        "hmacSha256SigningSecret": "<32-char-alphanumeric-secret>"
      }
    }
  ]
}
